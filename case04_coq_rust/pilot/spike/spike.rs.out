fn spike_genMoves_(&'a self, full: &'a Corelib_Init_Datatypes_list<'a, &'a Spike_At<'a>>, b: &'a Corelib_Init_Datatypes_list<'a, &'a Spike_At<'a>>, col: &'a Spike_color<'a>) -> &'a Corelib_Init_Datatypes_list<'a, __pair<Spike_sq<'a>, Spike_sq<'a>>> {
  match b {
    &Corelib_Init_Datatypes_list::nil(_) => {
      self.alloc(
        Corelib_Init_Datatypes_list::nil(
          PhantomData))
    },
    &Corelib_Init_Datatypes_list::cons(_, a, rest) => {
      let own =
        self.spike_genMoves_(
          full,
          rest,
          col);
      match self.spike_color_eqb(
              self.spike_at_color(
                a),
              col) {
        true => {
          match self.spike_at_piece(
                  a) {
            &Spike_piece::Knight(_) => {
              self.Corelib_Init_Datatypes_app(
                self.spike_moves_for(
                  self.spike_at_sq(
                    a),
                  self.spike_knight_offsets(),
                  full,
                  col),
                own)
            },
            &Spike_piece::King(_) => {
              self.Corelib_Init_Datatypes_app(
                self.spike_moves_for(
                  self.spike_at_sq(
                    a),
                  self.spike_king_offsets(),
                  full,
                  col),
                own)
            },
          }
        },
        false => {
          own
        },
      }
    },
  }
}
fn spike_genMoves___curried(&'a self) -> &'a dyn Fn(&'a Corelib_Init_Datatypes_list<'a, &'a Spike_At<'a>>) -> &'a dyn Fn(&'a Corelib_Init_Datatypes_list<'a, &'a Spike_At<'a>>) -> &'a dyn Fn(&'a Spike_color<'a>) -> &'a Corelib_Init_Datatypes_list<'a, __pair<Spike_sq<'a>, Spike_sq<'a>>> {
  self.closure(move |full| {
    self.closure(move |b| {
      self.closure(move |col| {
        self.spike_genMoves_(
          full,
          b,
          col)
      })
    })
  })
}

fn spike_genMoves(&'a self, b: &'a Corelib_Init_Datatypes_list<'a, &'a Spike_At<'a>>, col: &'a Spike_color<'a>) -> &'a Corelib_Init_Datatypes_list<'a, __pair<Spike_sq<'a>, Spike_sq<'a>>> {
  self.spike_genMoves_(
    b,
    b,
    col)
}
fn spike_genMoves__curried(&'a self) -> &'a dyn Fn(&'a Corelib_Init_Datatypes_list<'a, &'a Spike_At<'a>>) -> &'a dyn Fn(&'a Spike_color<'a>) -> &'a Corelib_Init_Datatypes_list<'a, __pair<Spike_sq<'a>, Spike_sq<'a>>> {
  self.closure(move |b| {
    self.closure(move |col| {
      self.spike_genMoves(
        b,
        col)
    })
  })
}

fn spike_spikeGen(&'a self) -> &'a dyn Fn(&'a Corelib_Init_Datatypes_list<'a, &'a Spike_At<'a>>) -> &'a dyn Fn(&'a Spike_color<'a>) -> &'a Corelib_Init_Datatypes_list<'a, __pair<Spike_sq<'a>, Spike_sq<'a>>> {
  self.spike_genMoves__curried()
}
