# nested working clones / arm worktrees — each has its own git
case*/upstream/
case*/arms/
# sealed ground truth (seeded-bug answer keys): NEVER in the repo — the
# ledger carries only the sha256; the orchestrator stays blind until grading
case*/sealed/
# raw headless outputs can be large; ledger/raw is tracked selectively
*.wasm
*.szx
__pycache__/
case*/paper/*.aux
case*/paper/*.log
case*/paper/*.out

# Manuscript — LOCAL ONLY, never published to the remote (operator, 2026-08-06)
case*/ARTICLE.md
case*/REPORT.md
case*/paper/
case*/paper_springer/*.aux
case*/paper_springer/*.log
case*/paper_springer/*.out
case*/paper_springer/*.bbl
case*/paper_springer/*.blg

# case02 grading: unblinding keys must never be committed
case*/grading/KEY_*.json
